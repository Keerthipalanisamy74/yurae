# FastAPI Backend Settings
PROJECT_NAME="YURAE BEAUTY"
VERSION="1.0.0"
SECRET_KEY="your_super_secret_jwt_key_here"

# Database Configuration (MySQL)
DATABASE_URL="mysql+pymysql://username:password@localhost:3306/yuraedb"

# Multi-Currency Configuration
BASE_CURRENCY="INR"
SUPPORTED_CURRENCIES="INR,USD,EUR,GBP,CAD,AUD,SGD,JPY"
EXCHANGE_RATE_API_URL="https://open.er-api.com/v6/latest/INR"
EXCHANGE_RATE_API_KEY=""

# India Domestic Payment Gateways
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# Global International Payment Gateways
STRIPE_PUBLIC_KEY="pk_test_your_stripe_public_key"
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
PAYPAL_CLIENT_ID="your_paypal_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret"

# Frontend Settings
VITE_API_BASE_URL="http://127.0.0.1:8000"
