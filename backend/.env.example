# ==============================================================================
# 🌸 YURAE BEAUTY — APPLICATION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core App Settings
SECRET_KEY=yurae_super_secret_jwt_key_2026_luxury_skincare_brand_origin
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (MySQL / MariaDB)
DATABASE_URL=mysql+pymysql://yuraeuser:Keerthi%4007@localhost:3306/yuraedb

# Multi-Currency Configuration
BASE_CURRENCY=INR
SUPPORTED_CURRENCIES=INR,USD,EUR,GBP,CAD,AUD,SGD,JPY
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/INR
EXCHANGE_RATE_API_KEY=

# Payment Gateways (India Domestic)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Payment Gateways (International Multi-Currency)
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# ==============================================================================
# 🚚 MULTI-REGION SHIPPING & ORDER FULFILLMENT (INDIA & INTERNATIONAL)
# ==============================================================================
# Mode: 'production' for live courier APIs, 'test' for high-fidelity sandbox simulation
SHIPPING_MODE=test

# Primary Shipping Providers
SHIPPING_PROVIDER=shiprocket
INTERNATIONAL_SHIPPING_PROVIDER=dhl_express

# Generic / Gateway API Keys
SHIPPING_API_KEY=
SHIPPING_API_SECRET=
SHIPPING_WEBHOOK_SECRET=yurae_universal_webhook_secret_2026

# Shiprocket Account Credentials (India Domestic: Blue Dart, Delhivery, Shadowfax)
# Register at: https://app.shiprocket.in
SHIPROCKET_EMAIL=your_shiprocket_email@yuraebeauty.com
SHIPROCKET_PASSWORD=your_shiprocket_api_password
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_PICKUP_LOCATION=Primary Warehouse
SHIPROCKET_WEBHOOK_TOKEN=yurae_shiprocket_webhook_secret_2026

# DHL Express / International Provider Credentials (Global: USA, UK, Canada, Australia, etc.)
# Register at: https://developer.dhl.com
DHL_API_KEY=your_dhl_api_key
DHL_API_SECRET=your_dhl_api_secret
DHL_ACCOUNT_NUMBER=your_dhl_import_export_account_number
DHL_BASE_URL=https://express.api.dhl.com/mydhlapi/test

# ==============================================================================
# 📦 SHIPPING RATES & CASH ON DELIVERY (COD) POLICIES
# ==============================================================================
# COD is strictly allowed ONLY for India ("IN")
COD_ENABLED=true
DEFAULT_FLAT_SHIPPING_FEE=99.00
DEFAULT_FREE_SHIPPING_THRESHOLD=1500.00
DEFAULT_COD_SURCHARGE=0.00
DEFAULT_DOMESTIC_EXPRESS_SURCHARGE=100.00

# International Shipping Defaults (USD base for cross-currency conversion)
DEFAULT_INTERNATIONAL_FLAT_FEE_USD=15.00
DEFAULT_INTERNATIONAL_FREE_THRESHOLD_USD=50.00
DEFAULT_INTERNATIONAL_EXPRESS_SURCHARGE_USD=15.00

# Default Luxury Packaging Dimensions (Cosmetics & Skincare Box)
DEFAULT_PACKAGE_WEIGHT_KG=0.45
DEFAULT_PACKAGE_LENGTH_CM=15.0
DEFAULT_PACKAGE_BREADTH_CM=10.0
DEFAULT_PACKAGE_HEIGHT_CM=8.0

# ==============================================================================
# 🏭 PRIMARY WAREHOUSE PICKUP ORIGIN (Default Dispatch Location)
# ==============================================================================
WAREHOUSE_CONTACT_NAME="YURAE Fulfillment Atelier"
WAREHOUSE_EMAIL="logistics@yuraebeauty.com"
